# Copy to .env.local and fill in values from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "supabase" enables database persistence; anything else falls back to localStorage
NEXT_PUBLIC_PERSISTENCE_MODE=local

# Server-only secrets (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Not currently used by the app; reserved for future admin scripts/API routes.
# SUPABASE_SERVICE_ROLE_KEY=
