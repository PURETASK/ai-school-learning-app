# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key

# Provider-backed signup/signin/reset. Keep false for local preview; enable in production.
AUTH_PROVIDER=supabase
AUTH_USE_SUPABASE_AUTH=false
AUTH_EMAIL_REDIRECT_TO=http://localhost:4173/
AUTH_PASSWORD_RESET_REDIRECT_TO=http://localhost:4173/
SUPABASE_CHILD_EMAIL_DOMAIN=students.example.edu

# Direct PostgreSQL connection for migrations and Postgres repository mode.
# This password is the database password from Supabase, not the API secret key.
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres?connect_timeout=10

# Production auth and repository mode. Use supabase-rest when the server cannot
# open a Postgres connection; it still requires the server-only Supabase secret.
NODE_ENV=production
K12_REPOSITORY_MODE=postgres
# K12_REPOSITORY_MODE=supabase-rest

# Parent-controlled gift-card fulfillment. Disabled by default because it can move real money.
GIFT_CARD_FULFILLMENT_ENABLED=false
GIFT_CARD_PROVIDER=manual
GIFT_CARD_DEFAULT_CENTS=1000
GIFT_CARD_MAX_CENTS=1000
GIFT_CARD_DAILY_LIMIT=5
GIFT_CARD_DAILY_BUDGET_CENTS=5000
GIFT_CARD_CURRENCY=USD

# Review-gated OpenAI image generation. Keep the real key in local/server env only.
OPENAI_API_KEY=your-server-only-openai-api-key
OPENAI_IMAGE_ENABLED=true
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_DAILY_LIMIT=12
OPENAI_IMAGE_MAX_COST_CENTS=25

# Guarded provider-backed student tutor. The local tutor remains the fallback when disabled,
# over the daily limit, moderated, or below the quality gate.
OPENAI_TUTOR_ENABLED=true
OPENAI_TUTOR_MODEL=gpt-4.1-mini
OPENAI_TUTOR_DAILY_LIMIT=30
OPENAI_TUTOR_DAILY_TOKEN_LIMIT=42000
OPENAI_TUTOR_MAX_INPUT_CHARS=2200
OPENAI_TUTOR_MAX_OUTPUT_TOKENS=700
OPENAI_TUTOR_MIN_REVIEW_AVERAGE=4
OPENAI_TUTOR_MAX_REVISION_ATTEMPTS=1

# Supabase Storage for approved visual assets. Create this bucket in Supabase Storage
# or run npm run storage:setup after server-only Supabase values are configured.
VISUAL_ASSET_STORAGE_BUCKET=k12-visual-assets
VISUAL_ASSET_STORAGE_AUTO_CREATE=false

# Tremendous-compatible external provider mode. Keep these server-only.
# GIFT_CARD_PROVIDER=tremendous
# TREMENDOUS_BASE_URL=https://testflight.tremendous.com/api/v2
# TREMENDOUS_API_KEY=replace-with-provider-api-key
# TREMENDOUS_FUNDING_SOURCE_ID=replace-with-funding-source-id
# TREMENDOUS_PRODUCT_ID=replace-with-product-id
# GIFT_CARD_ALLOW_LIVE_PROVIDER=false
